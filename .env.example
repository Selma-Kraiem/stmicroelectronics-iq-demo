# Local orchestrator
STIQ_LIVE_MODE=0
STIQ_ALLOW_TEAMS_SEND=0
SYNTHETIC_SEED=20260813
HOST=127.0.0.1
PORT=8000

# Azure scope - populate these values for your environment
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_RESOURCE_GROUP=rg-st-iq-demo
AZURE_LOCATION=swedencentral

# Foundry and Search - populated by scripts/setup.ps1
AZURE_AI_PROJECT_ENDPOINT=
AZURE_OPENAI_ENDPOINT=
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-5.4-mini
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_INDEX_NAME=st-iq-knowledge
KNOWLEDGE_SOURCE_NAME=st-iq-index-source
KNOWLEDGE_BASE_NAME=st-iq-knowledge-base
WEB_KNOWLEDGE_SOURCE_NAME=st-iq-web-source
WEB_KNOWLEDGE_BASE_NAME=st-iq-web-base
# FOUNDRY_AGENT_ENDPOINT must be the full Responses 2.0.0 invocation endpoint.
FOUNDRY_AGENT_ENDPOINT=
MARKET_TOOLBOX_ENDPOINT=
# Version-pinned Foundry toolbox. Fab sees only tool_search and call_tool initially.
INTERNAL_TOOLBOX_ENDPOINT=
STIQ_V1_DATA_ROOT=data/v1
# Optional legacy read toolbox. The active Fab path uses the OneDrive-only toolbox below.
WORK_IQ_TOOLBOX_ENDPOINT=
# Existing user-tested Foundry connections used by scripts/setup-work-iq-foundry.ps1.
WORK_IQ_CONNECTION_NAME=WorkIqConnection
WORK_IQ_ONEDRIVE_CONNECTION_NAME=WorkIqOneDriveConnection
WORK_IQ_TEAMS_CONNECTION_NAME=WorkIqTeamsConnection
# Private read-only toolbox; workbook bytes are decoded and calculated server-side.
WORK_IQ_ONEDRIVE_TOOLBOX_ENDPOINT=
# Separate write-capable toolbox; never attach this endpoint to an autonomous agent.
WORK_IQ_TEAMS_TOOLBOX_ENDPOINT=
WORK_IQ_TEAMS_SEND_TOOL=WorkIqTeamsConnection___SendMessageToUser
# Dedicated signed-in Hosted Agent endpoint; never expose this through the public app.
WORK_IQ_HOSTED_AGENT_ENDPOINT=
WORK_IQ_CLIENT_APPLICATION_ID=
WORK_IQ_EXPECTED_USER_UPN=presenter@contoso.onmicrosoft.com
# Exact same-tenant Microsoft 365 locations owned by the delegated presenter.
STIQ_ONEDRIVE_WORKBOOK_PATH=Documents/ST-IQ-Demo/SiC_AUTO_Shipments.xlsx
STIQ_SHAREPOINT_HANDBOOK_URL=https://contoso.sharepoint.com/Quality%20Ops/WorkIQ_SharePoint_Ops_Handbook.md
# Created by deploy-web.ps1. Never persist STIQ_INTERNAL_API_KEY itself.
V1_INTERNAL_CONNECTION_ID=

# Fabric workspace/Lakehouse IDs are non-secret. Ontology values are populated only
# after scripts/provision-fabric-iq.ps1 verifies a live MCP query.
FABRIC_WORKSPACE_ID=
FABRIC_LAKEHOUSE_ITEM_ID=
FABRIC_ONTOLOGY_ITEM_ID=
FABRIC_IQ_MCP_ENDPOINT=
FABRIC_IQ_TOOL_NAME=
FABRIC_IQ_TOOL_ARGUMENTS_JSON=
# Optional short-lived local override only; never persist this value.
FABRIC_IQ_ACCESS_TOKEN=

# Optional real SharePoint delegated sync into the Foundry IQ search index.
# scripts/setup-sharepoint-knowledge.ps1 updates these after a successful sync.
SHAREPOINT_KNOWLEDGE_MODE=blocked
SHAREPOINT_KNOWLEDGE_REASON=No approved SharePoint document library has been synchronized.

# Optional explicit Teams webhook. Live delivery additionally requires
# STIQ_ALLOW_TEAMS_SEND=1 and an explicit API opt-in on each send.
# Preferred Work IQ direct delivery. Live send still requires an explicit UI approval.
STIQ_TEAMS_RECIPIENT_UPN=presenter@contoso.com

# Isolated V2. It remains untouched by V1 deployment scripts.
FOUNDRY_V2_PROJECT_ENDPOINT=
FOUNDRY_V2_COMMANDER_ENDPOINT=
STIQ_V2_API_KEY=
V2_SEARCH_INDEX_NAME=st-iq-v2-documents
V2_KNOWLEDGE_SOURCE_NAME=st-iq-v2-document-source
V2_KNOWLEDGE_BASE_NAME=st-iq-v2-knowledge-base
V2_WEB_SOURCE_NAME=st-iq-v2-web-source
V2_WEB_BASE_NAME=st-iq-v2-web-base
